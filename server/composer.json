{
    "name": "matsvep/server",
    "description": "Matsvep server",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Matsvep\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Matsvep\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "php-cs-fixer check --config=.php-cs-fixer.dist.php --using-cache=no",
        "stan": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=512M"
    }
}
