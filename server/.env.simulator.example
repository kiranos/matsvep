# The source account needs SELECT only. Never use matsvep_app.
SOURCE_HOST=localhost
SOURCE_PORT=3306
SOURCE_DB=matsvep
SOURCE_USER=matsvep_sim_reader
SOURCE_PASSWORD=
# Run the command with sudo on the VPS for the local MySQL root socket.
TARGET_HOST=localhost
TARGET_PORT=3306
TARGET_USER=root
TARGET_PASSWORD=
TARGET_DB_PREFIX=matsvep_sim
